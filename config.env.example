CFB_FEISHU_APP_ID=
CFB_FEISHU_APP_SECRET=
CFB_FEISHU_DOMAIN=feishu
CFB_FEISHU_ALLOWED_USERS=
CFB_FEISHU_REQUIRE_MENTION=true
CFB_FEISHU_USE_CARDS=false

CFB_CODEX_WORKDIR=
CFB_CODEX_EXECUTABLE=codex
CFB_CODEX_MODEL=
CFB_CODEX_SANDBOX=danger-full-access
CFB_CODEX_APPROVAL_POLICY=never
CFB_CODEX_SKIP_GIT_REPO_CHECK=true
CFB_CODEX_BYPASS_APPROVALS_AND_SANDBOX=false
CFB_CODEX_CONFIG_OVERRIDES=
CFB_DEFAULT_THREAD_ID=

CFB_RESUME_RECOVERY_ENABLED=true
CFB_RESUME_RECOVERY_MAX_CHARS=12000
CFB_RESUME_RECOVERY_MAX_MESSAGES=24
CFB_NO_EVENT_TIMEOUT_MS=600000
CFB_HARD_TIMEOUT_MS=5400000
CFB_REPLY_MAX_CHARS=3500

CFB_FILE_TRANSFER_ENABLED=true
CFB_FILE_MAX_DOWNLOAD_MB=100
CFB_FILE_MAX_UPLOAD_MB=30
CFB_FILE_DOWNLOAD_DIR=
CFB_FILE_OUTBOX_DIR=
CFB_FILE_SEND_ROOTS=

# Optional: override Codex auth or config location for the spawned codex process.
# Usually you should leave these empty and use `codex login` normally.
CODEX_HOME=
OPENAI_API_KEY=
OPENAI_BASE_URL=
